{
  "manifest_version": 3,
  "name": "Vizardry",
  "version": "0.61.1",
  "description": "Render product-management frameworks from Markdown vizardry blocks — paste or open any .md file.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vizardry@grembl.de"
    }
  }
}
